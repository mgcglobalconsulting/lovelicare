# Copy to .env and fill in. Never commit .env.

# ── Supabase (REQUIRED — system of record for form submissions) ─────────────
# Project settings → Data API → Project URL
# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=
# Publishable key — safe to hold; tables are insert-only via RLS. PREFERRED.
SUPABASE_PUBLISHABLE_KEY=
# Only needed if the app must READ rows back. Secret — never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Owner dashboard (/dashboard) ────────────────────────────────────────────
# REQUIRED to enable the dashboard API. If unset, every /api/dashboard route
# returns 503 — it fails closed, so an unconfigured deploy exposes nothing.
# Generate with:  openssl rand -hex 32
DASHBOARD_TOKEN=
# NOTE: dashboard READS need SUPABASE_SERVICE_ROLE_KEY above. The tables are
# insert-only under RLS, so the publishable key's SELECT is denied.

# ── Chatbot ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Optional: email notification on new submissions ─────────────────────────
# Without these, submissions still save to Supabase; only the Gmail draft is skipped.
NOTIFY_EMAIL=LoveLiCareSvcs@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=

# Optional private Google Sheets operations database.
# Authorize the same OAuth client for spreadsheets.readonly; ChatGPT's Drive
# connection is separate from this deployed application's credentials.
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_RANGE=Dashboard!A4:B100

# ── Optional: content scraping (npm run scrape) ─────────────────────────────
FIRECRAWL_API_KEY=
